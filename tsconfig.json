{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmitOnError": true,
    "skipLibCheck": true,
    "rootDir": "src/main/frontend/ts",
    "outDir": "src/main/resources/static/js"
  },
  "include": ["src/main/frontend/ts/**/*.ts"]
}
